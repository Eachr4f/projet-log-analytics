%%{init: {'theme': 'dark'}}%%
flowchart TB

    subgraph SOURCE["🌐 SOURCE DE LOGS - Local (Docker)"]
        NGINX["Nginx<br/><i>Génère de vraies requêtes HTTP</i>"]
        LOAD["Générateur de charge<br/><i>wrk / hey / curl loop</i>"]
        FLB["Fluent Bit<br/><i>Parsing + transformation JSON</i>"]
        LOAD -->|"requêtes"| NGINX
        NGINX -->|"access.log"| FLB
    end

    subgraph K8S["☸️ CLUSTER KUBERNETES (Kind)"]
        direction TB
        subgraph NSKAFKA["Namespace: kafka"]
            STRIMZI["Strimzi Operator"]
            KAFKATOPIC["Kafka<br/><i>KafkaTopic: logs-raw</i><br/><i>KafkaTopic: logs-anomalies</i>"]
            STRIMZI -.->|"gère"| KAFKATOPIC
        end
        subgraph NSOBS["Namespace: observability"]
            LOKI_K8S["Loki<br/><i>Helm chart</i>"]
            GRAFANA_K8S["Grafana<br/><i>Helm chart</i>"]
        end
    end

    subgraph LOCAL["🐳 TRAITEMENT - Local (hors cluster)"]
        SPARK["Spark Streaming<br/><i>Parsing + Métriques + Scoring ML</i>"]
        ML["Modèle Isolation Forest<br/><i>scikit-learn (joblib)</i>"]
        SPARK <-->|"score anomalie"| ML
    end

    subgraph STORAGE["☁️ STOCKAGE & ALERTING - Cloud"]
        S3["S3<br/><i>Logs archivés + Modèles ML</i>"]
        SLACK["Alerting Slack<br/><i>Webhook + cooldown</i>"]
    end

    subgraph BATCH["⏱️ ORCHESTRATION - Docker Compose (hors cluster)"]
        AIRFLOW["Apache Airflow"]
        DAG1["DAG Agrégation"]
        DAG2["DAG Nettoyage"]
        DAG3["DAG Réentraînement ML"]
        AIRFLOW --> DAG1
        AIRFLOW --> DAG2
        AIRFLOW --> DAG3
    end

    subgraph CICD["🏗️ CI/CD - Multi-outils"]
        GIT["Git / GitHub"]
        GHA["GitHub Actions<br/><i>Lint, Terraform, Secrets</i>"]
        JENKINS["Jenkins<br/><i>Lint, Terraform, Secrets</i><br/><i>+ Déploiement K8s</i>"]
        GIT --> GHA
        GIT --> JENKINS
        JENKINS ==>|"kubectl apply"| K8S
    end

    FLB -->|"publie JSON"| KAFKATOPIC
    KAFKATOPIC -->|"NodePort / port-forward"| SPARK
    SPARK -->|"logs normaux"| S3
    SPARK -->|"écrit dans"| LOKI_K8S
    SPARK -->|"si anomalie"| KAFKATOPIC
    KAFKATOPIC -->|"topic anomalies"| SLACK
    LOKI_K8S --> GRAFANA_K8S
    S3 -.->|"lecture quotidienne"| DAG1
    S3 -.->|"lecture historique"| DAG3
    DAG1 -.->|"écrit rapport"| S3
    DAG3 -.->|"écrit nouveau modèle"| S3
    S3 -.->|"charge modèle"| ML

    classDef source fill:#fef3e0,stroke:#f9a825,stroke-width:1px,color:#1a1a1a
    classDef k8s fill:#e3f2fd,stroke:#1565c0,stroke-width:1px,color:#1a1a1a
    classDef local fill:#e8f0fe,stroke:#4285f4,stroke-width:1px,color:#1a1a1a
    classDef cloud fill:#fce4ec,stroke:#e91e63,stroke-width:1px,color:#1a1a1a
    classDef batch fill:#e6f4ea,stroke:#34a853,stroke-width:1px,color:#1a1a1a
    classDef cicd fill:#f3e5f5,stroke:#8e24aa,stroke-width:1px,color:#1a1a1a

    class NGINX,LOAD,FLB source
    class STRIMZI,KAFKATOPIC,LOKI_K8S,GRAFANA_K8S k8s
    class SPARK,ML local
    class S3,SLACK cloud
    class AIRFLOW,DAG1,DAG2,DAG3 batch
    class GIT,GHA,JENKINS cicd
